# ──────────────────────────────────────────────
# AlmaTour — Environment Variables
# Copy to .env and fill in real values
# ──────────────────────────────────────────────

# PostgreSQL / Neon connection string
# Neon format: postgresql+asyncpg://user:pass@host/dbname?ssl=require
DATABASE_URL=postgresql+asyncpg://neondb_owner:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/neondb?ssl=require

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# App
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Optional: Sentry DSN
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
